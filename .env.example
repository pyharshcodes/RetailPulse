# RetailPulse Environment Configuration

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Database Connection (SQLite WAL mode by default, or PostgreSQL)
DATABASE_URL=sqlite:///./backend/data/retailpulse.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/retailpulse

# Backend API Configuration
API_PORT=8000
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000
